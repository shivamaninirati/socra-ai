# =========================
# Splunk
# =========================
SPLUNK_HOST=localhost
SPLUNK_PORT=8089
SPLUNK_USERNAME=admin
SPLUNK_PASSWORD=your-splunk-password

# =========================
# Gemini AI
# =========================
GEMINI_API_KEY=your-gemini-api-key

# =========================
# Threat Intelligence providers (OPTIONAL)
# When a key is absent the provider reports a real "Provider not configured"
# state in the UI - reputation is never fabricated and keys are never
# returned to clients.
# =========================
# VT_API_KEY=
# ABUSEIPDB_API_KEY=

# =========================
# Ollama (OPTIONAL - used by the local AI investigation)
# The ollama client reads OLLAMA_HOST automatically; when unset it defaults
# to the local development instance (127.0.0.1:11434). Point it at your
# deployed Ollama host in production without editing source code.
# =========================
# OLLAMA_HOST=http://127.0.0.1:11434

# =========================
# JWT (REQUIRED — app refuses to start without a strong key)
# Generate one with:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
# =========================
SECRET_KEY=replace-with-a-random-string-of-at-least-32-characters
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60

# =========================
# Auth users
# Password hashes are PBKDF2-SHA256. Generate with:
#   python -c "from app.auth.auth_service import hash_password; print(hash_password('<password>'))"
# NEVER store plaintext passwords here.
# =========================
ADMIN_USERNAME=admin
ADMIN_PASSWORD_HASH=pbkdf2_sha256$600000$<salt>$<hash>
ANALYST_USERNAME=analyst
ANALYST_PASSWORD_HASH=pbkdf2_sha256$600000$<salt>$<hash>

# =========================
# OPTIONAL explicit admin bootstrap (disabled by default)
# No default admin account is ever auto-created with a fixed password.
# To create an administrator on a FRESH database, set BOTH variables:
#   BOOTSTRAP_ADMIN_EMAIL=admin@example.com
#   BOOTSTRAP_ADMIN_PASSWORD=choose-a-strong-password
# The password is stored only as a PBKDF2-SHA256 hash. If the email is set
# without a password the bootstrap is skipped safely. Never commit real
# values - keep them in your local .env only.
# =========================
# BOOTSTRAP_ADMIN_EMAIL=
# BOOTSTRAP_ADMIN_PASSWORD=

# =========================
# CORS (Task 25)
# Comma-separated list of allowed browser origins. Add your production host
# here without editing source code, e.g.:
#   CORS_ORIGINS=https://socra.example.com,http://localhost:5173
# =========================
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# =========================
# Logging
# =========================
LOG_LEVEL=INFO
LOG_FILE=socra.log
LOG_MAX_BYTES=10485760
LOG_BACKUP_COUNT=5
