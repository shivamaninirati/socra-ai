# =========================
# SOCRA AI Frontend — environment-driven deployment config (Task 25)
# =========================
# Copy to .env and adjust for your deployment. Both variables are optional:
# local development works without them (defaults point at 127.0.0.1:8000).

# Backend API base URL. In production point this at the deployed API,
# e.g. https://socra.example.com
# VITE_API_URL=http://127.0.0.1:8000

# WebSocket base URL (scheme + host only; the client appends /live/live).
# When unset, the host is derived from VITE_API_URL with https -> wss.
# HTTPS deployments MUST use wss:// — the JWT is never sent over a plain
# ws:// connection when the app is served over HTTPS.
# VITE_WS_URL=ws://127.0.0.1:8000
